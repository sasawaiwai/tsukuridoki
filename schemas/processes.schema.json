{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "processes.schema.json",
  "title": "加工マスター",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["process_id", "name", "group"],
    "properties": {
      "process_id": { "type": "string", "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "group": { "enum": ["foil_cover", "surface", "edge", "cutting", "body", "other"] }
    }
  }
}
