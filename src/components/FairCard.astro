---
// フェアカード（phase1.5-design.md 10〜14章・参考画像）
// 画像は使わず、上部のカテゴリ色の帯・テキスト・チップだけで成立させる
import type { CardModel } from '../lib/fair-display.ts';
import StatusLabel from './StatusLabel.astro';
import Chip from './Chip.astro';
import Icon from './Icon.astro';

interface Props {
  card: CardModel;
  headingLevel?: 'h2' | 'h3';
}

const { card, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="fair-card" data-category={card.category}>
  <div class="fair-card__band">
    {card.label && <StatusLabel {...card.label} />}
  </div>
  <div class="fair-card__body">
    <Heading class="fair-card__name">
      <a href={card.href}>{card.name}</a>
    </Heading>
    <p class="fair-card__printer">{card.printer}</p>
    {card.benefit && <p class="fair-card__benefit">{card.benefit}</p>}
    {
      card.chips.length > 0 && (
        <ul class="fair-card__chips" aria-label="加工・サイズ・印刷方式">
          {card.chips.map((chip) => (
            <li>
              <Chip label={chip.label} category={chip.category} />
            </li>
          ))}
          {card.hiddenChipCount > 0 && <li class="fair-card__more">+{card.hiddenChipCount}</li>}
        </ul>
      )
    }
    <p class="fair-card__deadline">
      <Icon name="calendar" size={16} />
      <span class="fair-card__deadline-text">{card.deadline}</span>
      <span class="fair-card__arrow" aria-hidden="true"><Icon name="arrow-right" size={14} /></span>
    </p>
  </div>
</article>

<style>
  .fair-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .fair-card:hover {
    border-color: color-mix(in srgb, var(--category-color) 50%, var(--color-border));
    box-shadow: 0 4px 12px rgba(41, 37, 34, 0.08);
  }

  /* カテゴリ色の帯（画像の代わり）。状態ラベルはここに置く */
  .fair-card__band {
    display: flex;
    align-items: center;
    min-height: 28px;
    padding: 4px var(--space-3);
    background: color-mix(in srgb, var(--category-color) 32%, white);
  }

  .fair-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    padding: var(--space-3) var(--space-4) var(--space-3);
  }

  .fair-card__name {
    font-size: var(--fs-base);
    line-height: 1.5;
  }

  .fair-card__name a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* カード全体をクリックできるようにする */
  .fair-card__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .fair-card__name a:focus-visible {
    outline: none;
  }

  .fair-card__name a:focus-visible::after {
    outline: 2px solid var(--color-primary-strong);
    outline-offset: -2px;
    border-radius: var(--radius);
  }

  .fair-card__printer {
    margin-top: calc(var(--space-1) * -1);
    color: var(--color-text-muted);
    font-size: var(--fs-xs);
  }

  /* 何がお得か：カテゴリ色の文字で、最大2行。それ以上は省略 */
  .fair-card__benefit {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    color: var(--category-text);
    font-weight: 700;
    line-height: 1.55;
  }

  .fair-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fair-card__more {
    align-self: center;
    color: var(--color-text-muted);
    font-size: var(--fs-xs);
  }

  .fair-card__deadline {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--fs-xs);
  }

  .fair-card__deadline-text {
    flex: 1;
    color: var(--color-text);
  }

  .fair-card__arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-text);
  }

  .fair-card:hover .fair-card__arrow {
    border-color: var(--color-primary-strong);
    background: var(--color-primary-strong);
    color: #fff;
  }
</style>
