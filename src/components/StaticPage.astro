---
// 文章ページの共通の枠（サイト必須ページ：仕様書45-2）
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatJpDateFull } from '../lib/fair-display.ts';

interface Props {
  title: string;
  description: string;
  updated?: string; // 最終更新日（YYYY-MM-DD）
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container static-page">
    <h1>{title}</h1>
    <div class="static-page__body">
      <slot />
    </div>
    {updated && <p class="static-page__updated">最終更新：{formatJpDateFull(updated)}</p>}
  </article>
</BaseLayout>

<style>
  .static-page {
    display: grid;
    gap: var(--space-5);
    max-width: 800px;
    padding-top: var(--space-5);
  }

  .static-page__body {
    display: grid;
    gap: var(--space-4);
  }

  .static-page__body :global(h2) {
    margin-top: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--fs-lg);
  }

  .static-page__body :global(ul) {
    margin: 0;
    padding-left: 1.4em;
  }

  .static-page__body :global(.static-page__box) {
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-primary-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-weight: 700;
  }

  .static-page__updated {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
</style>
