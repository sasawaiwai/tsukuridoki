---
// ヒーロー（phase1.5-design.md 6章）。PC：左コピー・右画像／スマホ：縦並び
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  imageSrc?: string;
}

const { imageSrc } = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title"><span>本が作りたくなる、</span><span>フェアが見つかる。</span></h1>
      <p class="hero__sub">同人誌印刷所のフェアを、もっと自由に、もっと楽しく。</p>
    </div>
    <div class="hero__image">
      <ImagePlaceholder
        src={imageSrc}
        alt="ツクリドキ！のイメージ画像"
        ratio="4 / 3"
        label="ヒーロー画像（4:3・推奨1600×1200px）"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  /* フレーズの途中で改行しない（1行ずつ表示） */
  .hero__title span {
    display: inline-block;
  }

  .hero__sub {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--fs-lg);
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-8);
    }

    .hero__inner {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-7);
    }
  }
</style>
