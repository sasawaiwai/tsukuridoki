---
// セクション見出し＋「もっと見る →」
interface Props {
  title: string;
  lead?: string;
  moreHref?: string;
  moreLabel?: string;
  id?: string;
}

const { title, lead, moreHref, moreLabel = 'すべて見る', id } = Astro.props;
---

<div class="section-header">
  <div>
    <h2 id={id}>{title}</h2>
    {lead && <p class="section-header__lead">{lead}</p>}
  </div>
  {moreHref && <a class="section-header__more" href={moreHref}>{moreLabel} ›</a>}
</div>

<style>
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .section-header__lead {
    margin-top: var(--space-1);
    word-break: keep-all;
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  .section-header__more {
    flex-shrink: 0;
    color: var(--color-text);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .section-header__more:hover {
    text-decoration: underline;
  }
</style>
