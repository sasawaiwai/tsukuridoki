---
// 加工・特典から探す。補助的な検索導線なので、装飾を付けずテキストリンクを「/」区切りで並べる
import { POPULAR_PROCESS_LINKS, SEARCH_HREF } from '../lib/nav.ts';
import SectionHeader from './SectionHeader.astro';

interface Props {
  id?: string;
  /** 見出しを一段小さくする（トップ。「フェアを見る」より控えめにする） */
  compact?: boolean;
}

const { id, compact = false } = Astro.props;
---

<section class:list={['popular', { 'popular--compact': compact }]} aria-labelledby={id}>
  <SectionHeader id={id} title="加工・特典から探す" moreHref={SEARCH_HREF} />
  <div class="popular__clip">
    <ul class="popular__list">
      {
        POPULAR_PROCESS_LINKS.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .popular--compact :global(h2) {
    font-size: var(--fs-lg);
  }

  .popular--compact :global(.section-header) {
    margin-bottom: var(--space-2);
  }

  /*
   * 区切りの「/」は各項目の前に置き、行頭に来たものは左端の外へ出して隠す（行頭・行末に「/」だけが残らない）。
   * 外枠の上下左右に余白を取り、フォーカスの枠線が切れないようにする
   */
  .popular__clip {
    --sep: 1.5em;
    overflow: hidden;
    margin: calc(var(--space-1) * -1);
    padding: var(--space-1);
  }

  .popular__list {
    display: flex;
    flex-wrap: wrap;
    margin: 0 0 0 calc(var(--sep) * -1);
    padding: 0;
    list-style: none;
  }

  .popular__list li {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .popular__list li::before {
    content: '/';
    width: var(--sep);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* タップしやすい高さ（44px）を確保する */
  .popular__list a {
    padding: 10px 2px;
    color: var(--color-text);
    line-height: 1.5;
    text-decoration: none;
  }

  .popular__list a:hover,
  .popular__list a:focus-visible {
    color: var(--color-primary-strong);
    text-decoration: underline;
  }
</style>
