---
// ヘッダー（phase1.5-design.md 17章・参考画像）。生成りの背景になじませ、常にコンパクトに
// PC：ロゴ＋ナビ＋検索／スマホ：ロゴ＋検索＋メニュー
import { SITE } from '../lib/site.ts';
import { HEADER_LINKS, SEARCH_HREF } from '../lib/nav.ts';
import Icon from './Icon.astro';

const current = Astro.url.pathname;
const isCurrent = (href: string) => current.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <span class="site-header__name">{SITE.name}</span>
      <span class="site-header__subtitle">{SITE.subtitle}</span>
    </a>

    <nav class="site-header__nav" aria-label="メインメニュー">
      <ul>
        {
          HEADER_LINKS.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={SEARCH_HREF} class="site-header__icon-button" aria-label="フェアを検索">
      <Icon name="search" size={24} />
    </a>

    <details class="site-header__menu">
      <summary class="site-header__icon-button" aria-label="メニュー">
        <Icon name="menu" size={26} />
      </summary>
      <nav aria-label="メニュー">
        <ul>
          {
            HEADER_LINKS.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 5;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    padding-block: var(--space-2);
  }

  .site-header__logo {
    display: flex;
    flex-direction: column;
    margin-right: auto;
    text-decoration: none;
  }

  .site-header__name {
    color: var(--color-primary);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1.15;
  }

  .site-header__subtitle {
    color: var(--color-text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav ul,
  .site-header__menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-6);
  }

  .site-header__nav a,
  .site-header__menu a {
    color: var(--color-text);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--color-primary-strong);
  }

  .site-header__icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    color: var(--color-text);
    cursor: pointer;
  }

  .site-header__icon-button:hover {
    background: rgba(41, 37, 34, 0.05);
    color: var(--color-text);
  }

  .site-header__menu summary {
    list-style: none;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__menu[open] nav {
    position: absolute;
    top: 100%;
    left: var(--gutter);
    right: var(--gutter);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 6px 16px rgba(41, 37, 34, 0.08);
  }

  .site-header__menu li + li a {
    border-top: 1px solid var(--color-border);
  }

  .site-header__menu li a {
    display: block;
    padding: var(--space-3) 0;
  }

  @media (min-width: 1024px) {
    .site-header__inner {
      gap: var(--space-6);
      min-height: 76px;
    }

    .site-header__name {
      font-size: 1.85rem;
    }

    .site-header__nav {
      display: block;
    }

    .site-header__menu {
      display: none;
    }
  }
</style>
