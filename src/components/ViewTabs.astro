---
// トップの6つの見方のタブ（仕様書40-2、timing-design 4-1）。
// タブはそれぞれの一覧ページへの普通のリンク。JavaScript が動くときだけ、押したタブの部品ページ（/dojin/tab/{見方}/）を
// 読み込んで、この場で表示を切り替える。読み込みに失敗したら普通にリンク先へ移動する。
// HTML に入れる一覧は、最初に開いているタブ（開催中）の全件だけ。中身はカテゴリ別の一覧（FairList）
import FairList from './FairList.astro';
import type { CategoryGroup } from '../lib/categories.ts';
import type { CardModel } from '../lib/fair-display.ts';
import { FAIRS_SECTION_ID } from '../lib/nav.ts';

export interface ViewTab {
  key: string;
  label: string;
  /** 一覧ページ */
  href: string;
  /** タブ用の部品ページ */
  fragment: string;
  /** 件数の行に出す名前（一覧ページの見出し。例：来月（12月）使えるフェア） */
  title: string;
}

interface Props {
  tabs: ViewTab[];
  /** 最初に開いているタブ（tabs の先頭）のカテゴリ別の一覧 */
  groups: CategoryGroup<CardModel>[];
  /** 最初に開いているタブのフェアの件数（重複なし） */
  total: number;
}

const { tabs, groups, total } = Astro.props;
---

<div class="view-tabs" data-view-tabs>
  <ul class="view-tabs__list">
    {
      tabs.map((tab, i) => (
        <li>
          <a class="view-tabs__tab" href={tab.href} data-tab={tab.key} data-fragment={tab.fragment} data-title={tab.title} aria-current={i === 0 ? 'true' : undefined}>
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>

  <!-- 読み上げるのは件数の行だけ（一覧全体を読み上げ対象にしない） -->
  <p class="view-tabs__status" aria-live="polite" aria-atomic="true" data-tab-status>
    <strong data-tab-title>{tabs[0].title}</strong> <span data-tab-total>{total}</span>件
  </p>

  <div class="view-tabs__panel" data-tab-panel>
    <FairList groups={groups} />
  </div>

  <!-- 長い一覧の途中から、タブとカテゴリへの移動に戻る（JavaScript なしで動くページ内リンク） -->
  <p class="view-tabs__back">
    <a href={`#${FAIRS_SECTION_ID}`}><span aria-hidden="true">↑</span><span class="view-tabs__back-text">タブ・カテゴリへ</span></a>
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-view-tabs]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('[data-tab-panel]')!;
    const title = root.querySelector<HTMLElement>('[data-tab-title]')!;
    const total = root.querySelector<HTMLElement>('[data-tab-total]')!;
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('a[data-tab]')];

    // 読み込んだタブは覚えておき、2回目からはすぐ切り替える
    const cache = new Map<string, { html: string; total: string }>();
    cache.set(tabs[0].dataset.tab!, { html: panel.innerHTML, total: total.textContent ?? '0' });

    async function load(tab: HTMLAnchorElement) {
      const cached = cache.get(tab.dataset.tab!);
      if (cached) return cached;
      const res = await fetch(tab.dataset.fragment!);
      if (!res.ok) throw new Error(String(res.status));
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const content = doc.querySelector<HTMLElement>('[data-tab-content]');
      if (!content) throw new Error('no content');
      const entry = { html: content.innerHTML, total: content.dataset.total ?? '0' };
      cache.set(tab.dataset.tab!, entry);
      return entry;
    }

    for (const tab of tabs) {
      tab.addEventListener('click', async (event) => {
        // 新しいタブで開くなどの操作は、普通のリンクとして扱う
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        let entry;
        try {
          entry = await load(tab);
        } catch {
          location.href = tab.href; // 読み込めなければ一覧ページへ
          return;
        }
        panel.innerHTML = entry.html;
        for (const t of tabs) t.toggleAttribute('aria-current', t === tab);
        tab.setAttribute('aria-current', 'true');
        title.textContent = tab.dataset.title!;
        total.textContent = entry.total;
      });
    }
  }
</script>

<style>
  .view-tabs {
    display: grid;
    gap: var(--space-5);
  }

  /* スマホ：3列×2段のボタン。6つ全部が見え、横スクロールしない */
  .view-tabs__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .view-tabs__tab {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--fs-sm);
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
  }

  .view-tabs__tab:hover {
    border-color: var(--color-primary);
  }

  .view-tabs__tab[aria-current='true'] {
    border-color: var(--color-primary-strong);
    background: var(--color-primary-strong);
    color: #fff;
  }

  /* タブレット・PC：下線のタブ */
  @media (min-width: 768px) {
    .view-tabs__list {
      display: flex;
      gap: var(--space-2);
      border-bottom: 1px solid var(--color-border);
    }

    .view-tabs__tab {
      padding: 0 var(--space-4);
      border: 0;
      border-bottom: 3px solid transparent;
      border-radius: var(--radius) var(--radius) 0 0;
      background: none;
      color: var(--color-text-muted);
      font-size: var(--fs-base);
    }

    .view-tabs__tab:hover {
      color: var(--color-text);
      background: var(--color-surface-sunken);
    }

    .view-tabs__tab[aria-current='true'] {
      border-bottom-color: var(--color-primary);
      background: none;
      color: var(--color-primary-strong);
    }
  }

  .view-tabs__status {
    margin-top: calc(var(--space-2) * -1);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  .view-tabs__status strong {
    color: var(--color-text);
  }

  /*
   * 「タブ・カテゴリへ」：一覧が画面にある間だけ、画面の右下に小さく残る（position: sticky。JavaScript なし）。
   * 段落は下の行のクリックを邪魔しないよう pointer-events を切り、リンクだけ押せるようにする
   */
  .view-tabs__back {
    position: sticky;
    bottom: var(--space-4);
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    margin: 0;
    pointer-events: none;
  }

  /* スマホ：本文を隠しにくいよう、矢印だけの小さな丸（文字は読み上げ用に残す） */
  .view-tabs__back a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3em;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    font-size: var(--fs-base);
    text-decoration: none;
    pointer-events: auto;
  }

  .view-tabs__back-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* タブレット・PC：文字付きの小さなボタン */
  @media (min-width: 768px) {
    .view-tabs__back a {
      width: auto;
      padding: 0 var(--space-4);
      font-size: var(--fs-sm);
    }

    .view-tabs__back-text {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
  }

  .view-tabs__back a:hover {
    border-color: var(--color-primary-strong);
    color: var(--color-primary-strong);
  }
</style>
