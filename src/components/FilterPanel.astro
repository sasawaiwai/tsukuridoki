---
// 検索ページの絞り込み（phase1.5-design.md 19章）。絞り込みの動作は /dojin/fairs/ のスクリプトで行う
// PC：左サイドバーとして常に表示／スマホ・タブレット：「絞り込み」ボタンで開閉
// 選択肢は、フェアが1件以上（終了済み含む）ある値だけ出す
import type { SiteData } from '../lib/types.ts';
import { ATTRIBUTE_AXES } from '../lib/lists.ts';
import Button from './Button.astro';

interface Props {
  data: SiteData;
}

const { data } = Astro.props;

const axis = (name: string) => {
  const def = ATTRIBUTE_AXES.find((d) => d.axis === name)!;
  const used = new Set(data.fairs.flatMap(def.of));
  return { legend: def.label, name, type: 'checkbox' as const, options: def.options(data).filter((o) => used.has(o.value)) };
};

const usedPrinters = new Set(data.fairs.map((f) => f.printer_id));

const groups: { legend: string; name: string; type: 'radio' | 'checkbox'; options: { value: string; label: string }[] }[] = [
  {
    legend: '時期',
    name: 'period',
    type: 'radio',
    options: [
      { value: '', label: '指定なし' },
      { value: 'within-7-days', label: '今から7日以内' },
      { value: 'next-weekend', label: '次の週末に間に合う' },
      { value: '1month', label: '1か月先でも' },
      { value: '2months', label: '2か月先でも' },
      { value: '3months', label: '3か月先でも' },
      { value: '6months', label: '半年先でも' },
    ],
  },
  axis('size'),
  axis('process'),
  axis('printing'),
  axis('color'),
  {
    legend: '印刷所',
    name: 'printer',
    type: 'checkbox',
    options: data.printers
      .filter((p) => p.crawl_policy !== 'forbidden' && usedPrinters.has(p.printer_id))
      .map((p) => ({ value: p.printer_id, label: p.name })),
  },
  axis('benefit'),
].filter((g) => g.options.length > 0);
---

<div class="filter" data-filter>
  <button type="button" class="filter__toggle" aria-expanded="false" aria-controls="filter-panel" data-filter-toggle>
    絞り込み
  </button>

  <form id="filter-panel" class="filter__panel" aria-label="絞り込み" data-filter-form>
    {
      groups.map((group) => (
        <fieldset class="filter__group">
          <legend>{group.legend}</legend>
          <div class="filter__options">
            {group.options.map((option) => (
              <label>
                <input type={group.type} name={group.name} value={option.value} checked={group.type === 'radio' && option.value === ''} />
                {option.label}
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
    <label class="filter__expired">
      <input type="checkbox" name="include_expired" value="1" />
      終了済みも表示
    </label>
    <p class="filter__reset">
      <Button variant="ghost" data-filter-reset>条件をクリア</Button>
    </p>
  </form>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-filter]')) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-filter-toggle]');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      root.toggleAttribute('data-open', open);
    });
  }
</script>

<style>
  .filter__toggle {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .filter__toggle::after {
    content: ' ＋';
  }

  .filter__toggle[aria-expanded='true']::after {
    content: ' －';
  }

  .filter__panel {
    display: none;
    margin-top: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .filter[data-open] .filter__panel {
    display: block;
  }

  .filter__reset {
    margin-top: var(--space-3);
  }

  .filter__group {
    margin: 0 0 var(--space-4);
    padding: 0 0 var(--space-4);
    border: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .filter__group legend {
    margin-bottom: var(--space-2);
    padding: 0;
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .filter__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  .filter label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-sm);
    cursor: pointer;
  }

  .filter input {
    accent-color: var(--color-primary-strong);
  }

  @media (min-width: 1024px) {
    .filter__toggle {
      display: none;
    }

    .filter__panel {
      display: block;
      margin-top: 0;
    }

    .filter__options {
      flex-direction: column;
    }
  }
</style>
