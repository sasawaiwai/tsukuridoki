---
// 加工から探す（phase1.5-design.md 9章）：タグ／チップ＋簡単な色分け
import { PROCESS_LINKS } from '../lib/nav.ts';
import Chip from './Chip.astro';
---

<ul class="process-nav">
  {
    PROCESS_LINKS.map((link) => (
      <li>
        <Chip label={link.label} href={link.href} category={link.category} size="md" />
      </li>
    ))
  }
</ul>

<style>
  .process-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
