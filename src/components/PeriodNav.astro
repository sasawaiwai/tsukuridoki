---
// 時期・目的別の導線（phase1.5-design.md 8章・参考画像）。「次の週末に間に合う」は該当があるときだけ出す
// スマホ：3列（「加工から探す」は横長）／タブレット：4列／PC（1280px以上）：1行
import { PERIOD_PAGES, POPULAR_PROCESS_ANCHOR } from '../lib/nav.ts';
import type { CardCategory } from '../lib/fair-display.ts';
import Icon from './Icon.astro';

interface Props {
  showNextWeekend: boolean;
}

const { showNextWeekend } = Astro.props;

// 折り返すときは | の位置で改行する（「間に合/う」のような途中での改行を防ぐ）
const BREAK_HINTS: Record<string, string> = {
  今から7日以内: '今から|7日以内',
  次の週末に間に合う: '次の週末に|間に合う',
  加工から探す: '加工から|探す',
};

// アイコンの色は加工カテゴリの色を借りて、見本帳のように少しずつ変える
const links: { label: string; href: string; note: string; color: CardCategory; icon: 'calendar' | 'pencil'; wide?: boolean }[] = [
  { ...PERIOD_PAGES.within7Days, note: 'すぐに使える', color: 'deal', icon: 'calendar' },
  ...(showNextWeekend
    ? [{ ...PERIOD_PAGES.nextWeekend, note: 'イベント合わせ', color: 'rgb' as const, icon: 'calendar' as const }]
    : []),
  { ...PERIOD_PAGES.month1, note: '使える', color: 'surface', icon: 'calendar' },
  { ...PERIOD_PAGES.month2, note: '使える', color: 'deal', icon: 'calendar' },
  { ...PERIOD_PAGES.month3, note: '使える', color: 'foil', icon: 'calendar' },
  { ...PERIOD_PAGES.month6, note: '使える', color: 'paper', icon: 'calendar' },
  { label: '加工から探す', href: POPULAR_PROCESS_ANCHOR, note: '箔・特殊紙など', color: 'foil', icon: 'pencil', wide: true },
];
---

<nav class="period-nav" aria-label="時期・目的から探す">
  <ul>
    {
      links.map((link) => (
        <li class:list={{ 'period-nav__wide': link.wide }}>
          <a href={link.href} data-category={link.color}>
            <span class="period-nav__icon">
              <Icon name={link.icon} size={24} />
            </span>
            <span class="period-nav__text">
              <span class="period-nav__label">
                {(BREAK_HINTS[link.label] ?? link.label).split('|').map((part, i) => (
                  <>
                    {i > 0 && <wbr />}
                    {part}
                  </>
                ))}
              </span>
              <span class="period-nav__note">{link.note}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .period-nav ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .period-nav__wide {
    grid-column: 1 / -1;
  }

  .period-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-3) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-align: center;
    text-decoration: none;
  }

  .period-nav__wide a {
    flex-direction: row;
    justify-content: center;
    gap: var(--space-3);
    text-align: left;
  }

  .period-nav a:hover {
    border-color: var(--category-color);
  }

  .period-nav__icon {
    color: var(--category-color);
  }

  .period-nav__text {
    display: flex;
    flex-direction: column;
  }

  .period-nav__label {
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.45;
    word-break: keep-all;
  }

  .period-nav__note {
    color: var(--color-text-muted);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .period-nav ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .period-nav__wide {
      grid-column: auto;
    }

    .period-nav a,
    .period-nav__wide a {
      flex-direction: row;
      justify-content: flex-start;
      gap: var(--space-3);
      padding: var(--space-3) var(--space-4);
      text-align: left;
    }
  }

  @media (min-width: 1280px) {
    .period-nav ul {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }

    .period-nav a,
    .period-nav__wide a {
      gap: var(--space-2);
      padding: var(--space-3);
    }
  }
</style>
