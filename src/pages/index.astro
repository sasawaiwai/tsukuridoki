---
// トップページ（仕様書40章、timing-design 4-1）
// トップ＝フェアを発見する場所。6つの見方のタブ（各一覧ページへのリンク）ごとに、加工・特典カテゴリ別の全件を眺められる
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ViewTabs, { type ViewTab } from '../components/ViewTabs.astro';
import { SITE } from '../lib/site.ts';
import { FAIRS_SECTION_ID, LIST_PAGES, PRINTERS_HREF, TAB_VIEWS, tabFragmentHref } from '../lib/nav.ts';
import { cardBuilder } from '../lib/cards.ts';
import { groupByCategory } from '../lib/categories.ts';
import { listPages } from '../lib/lists.ts';
import { todayJST } from '../lib/period.ts';

const today = todayJST();
const { data, toCard } = cardBuilder(today);
const pages = listPages(today);
const titleOf = (key: string) => pages.find((p) => p.slug === key)!.title;

const tabs: ViewTab[] = TAB_VIEWS.map((key) => ({ key, label: LIST_PAGES[key].label, href: LIST_PAGES[key].href, fragment: tabFragmentHref(key), title: titleOf(key) }));
const firstFairs = pages.find((p) => p.slug === TAB_VIEWS[0])!.select(data.fairs);
---

<BaseLayout dated>
  <Hero imageSrc={SITE.heroImage ?? undefined} imageAlt={SITE.heroImageAlt} />

  <div class="container top">
    <section>
      <SectionHeader id={FAIRS_SECTION_ID} title="フェアを見る" />
      <ViewTabs tabs={tabs} groups={groupByCategory(firstFairs, toCard)} total={firstFairs.length} />
    </section>

    <section class="about">
      <SectionHeader title="このサイトについて" />
      <p class="about__voices">
        「次に作る本、どんな加工にしよう？」<br />
        「初めての同人誌だから、お得に作りたい！」<br />
        「突発本だけど、何かひと工夫したい！」
      </p>
      <p>そんな同人作家さんのために、各印刷所のフェアやキャンペーン情報をまとめました。</p>
      <p>開催中のフェアから、来月・年内に使えるフェア、いつでも使える常設の割引、箔押し・特殊紙・RGB印刷などの加工別フェアまで。</p>
      <p>眺めているだけで、次の本を作りたくなる。</p>
      <p class="about__name"><strong>{SITE.name}</strong>｜{SITE.tagline}</p>
    </section>

    <p class="printers-link"><a href={PRINTERS_HREF}>掲載中の印刷所を見る →</a></p>
  </div>
</BaseLayout>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  /* 「タブ・カテゴリへ」で戻ったとき、見出しが画面の端にくっつかないように */
  .top :global(#fairs) {
    scroll-margin-top: var(--space-4);
  }

  .about {
    display: grid;
    gap: var(--space-3);
    max-width: 760px;
  }

  .about__voices {
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.9;
  }

  .about__name {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  .printers-link {
    margin-top: calc(var(--space-5) * -1);
    font-size: var(--fs-sm);
  }
</style>
