---
// トップページ（仕様書40-1、timing-design 4-1）
// トップ＝フェアを発見する場所。6つの見方のタブ（各一覧ページへのリンク）と、人気の加工から入る
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ViewTabs, { type ViewTab } from '../components/ViewTabs.astro';
import PopularProcesses from '../components/PopularProcesses.astro';
import { SITE } from '../lib/site.ts';
import { LIST_PAGES, MORE_LABELS, PRINTERS_HREF, TAB_VIEWS, tabFragmentHref } from '../lib/nav.ts';
import { cardBuilder } from '../lib/cards.ts';
import { listPages, TAB_SIZE } from '../lib/lists.ts';
import { todayJST } from '../lib/period.ts';

const today = todayJST();
const { data, toCard } = cardBuilder(today);

const tabs: ViewTab[] = TAB_VIEWS.map((key) => ({ key, label: LIST_PAGES[key].label, href: LIST_PAGES[key].href, fragment: tabFragmentHref(key), moreLabel: MORE_LABELS[key] }));
const firstFairs = listPages(today).find((p) => p.slug === TAB_VIEWS[0])!.select(data.fairs);
---

<BaseLayout>
  <Hero imageSrc={SITE.heroImage ?? undefined} imageAlt={SITE.heroImageAlt} />

  <div class="container top">
    <PopularProcesses id="popular-processes" />

    <section>
      <SectionHeader title="フェアを見る" />
      <ViewTabs tabs={tabs} cards={firstFairs.slice(0, TAB_SIZE).map(toCard)} total={firstFairs.length} />
    </section>

    <section class="about">
      <SectionHeader title="このサイトについて" />
      <p class="about__voices">
        「次に作る本、どんな加工にしよう？」<br />
        「初めての同人誌だから、お得に作りたい！」<br />
        「突発本だけど、何かひと工夫したい！」
      </p>
      <p>そんな同人作家さんのために、各印刷所のフェアやキャンペーン情報をまとめました。</p>
      <p>今開催中のフェアから、来月・年内に使えるフェア、いつでも使える常設の割引、箔押し・特殊紙・RGB印刷などの加工別フェアまで。</p>
      <p>眺めているだけで、次の本を作りたくなる。</p>
      <p class="about__name"><strong>{SITE.name}</strong>｜{SITE.tagline}</p>
    </section>

    <p class="printers-link"><a href={PRINTERS_HREF}>掲載中の印刷所を見る →</a></p>
  </div>
</BaseLayout>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  .about {
    display: grid;
    gap: var(--space-3);
    max-width: 760px;
  }

  .about__voices {
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.9;
  }

  .about__name {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  .printers-link {
    margin-top: calc(var(--space-5) * -1);
    font-size: var(--fs-sm);
  }
</style>
