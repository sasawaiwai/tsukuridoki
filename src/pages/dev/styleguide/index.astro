---
// 部品の確認ページ（仕様書52-6）。デザインシステムの見本
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import FairGrid from '../../../components/FairGrid.astro';
import StatusLabel from '../../../components/StatusLabel.astro';
import Chip from '../../../components/Chip.astro';
import Button from '../../../components/Button.astro';
import PopularProcesses from '../../../components/PopularProcesses.astro';
import ViewTabs, { type ViewTab } from '../../../components/ViewTabs.astro';
import Pagination from '../../../components/Pagination.astro';
import { LIST_PAGES, MORE_LABELS, TAB_VIEWS, tabFragmentHref } from '../../../lib/nav.ts';
import ImagePlaceholder from '../../../components/ImagePlaceholder.astro';
import { cardBuilder } from '../../../lib/cards.ts';
import { todayJST } from '../../../lib/period.ts';
import type { CardModel } from '../../../lib/fair-display.ts';

const today = todayJST();
const { data, toCard } = cardBuilder(today);
const sampleCards = data.fairs.map(toCard);
const tabs: ViewTab[] = TAB_VIEWS.map((key) => ({ key, label: LIST_PAGES[key].label, href: LIST_PAGES[key].href, fragment: tabFragmentHref(key), moreLabel: MORE_LABELS[key] }));
// ページ送りの見本（3ページ中の2ページ目）
const samplePage = {
  data: [],
  start: 24,
  end: 47,
  size: 24,
  total: 60,
  currentPage: 2,
  lastPage: 3,
  url: { current: '/dojin/this-month/2/', prev: '/dojin/this-month/', next: '/dojin/this-month/3/', first: '/dojin/this-month/', last: '/dojin/this-month/3/' },
} as const;

// 表示の限界を確認するための架空のカード
const edgeCases: CardModel[] = [
  {
    href: '#',
    name: 'とても長いフェア名の場合の表示確認用サンプル・秋冬の特殊加工まとめて応援キャンペーン',
    printer: 'さんぷる印刷（架空）',
    category: 'paper',
    label: { kind: 'update', text: 'UPDATE' },
    benefit: '対象の特殊紙すべてで表紙用紙の変更が無料、さらに遊び紙も1枚無料で追加できるうえ、早期入稿で5%引き',
    chips: [
      { label: '特殊紙', category: 'paper' },
      { label: '遊び紙', category: 'craft' },
      { label: 'A6' },
      { label: '文庫' },
      { label: 'オンデマンド' },
    ],
    hiddenChipCount: 4,
    deadline: '2026年12月20日 入稿分まで（年末年始の休業期間を除く）',
  },
  {
    href: '#',
    name: 'ラベル・特典・チップなし',
    printer: 'みほん堂（架空）',
    category: 'other',
    label: null,
    benefit: '',
    chips: [],
    hiddenChipCount: 0,
    deadline: '期間未定',
  },
];

const colors = [
  ['--color-bg', '背景'],
  ['--color-surface', '面'],
  ['--color-surface-sunken', '沈んだ面'],
  ['--color-text', '文字'],
  ['--color-text-muted', '補足文字'],
  ['--color-border', '罫線'],
  ['--color-primary', 'ブランド（装飾・大見出し）'],
  ['--color-primary-dark', 'ブランド濃'],
  ['--color-primary-strong', 'リンク・ボタン'],
];

const categories = [
  ['foil', '箔押し'],
  ['paper', '特殊紙'],
  ['rgb', 'RGB印刷'],
  ['surface', 'PP・表面加工'],
  ['craft', '遊び紙・紙加工'],
  ['deal', '割引・価格系'],
  ['other', 'その他'],
] as const;
---

<BaseLayout title="スタイルガイド" noindex>
  <div class="container guide">
    <div>
      <h1>スタイルガイド</h1>
      <p class="muted">開発用：デザインシステムの部品一覧（Phase 1.5）。判定基準日：{today}</p>
    </div>

    <section>
      <SectionHeader title="カラー" />
      <ul class="swatches">
        {
          colors.map(([token, name]) => (
            <li>
              <span class="swatch" style={`background: var(${token})`} />
              <span>
                {name}
                <code>{token}</code>
              </span>
            </li>
          ))
        }
      </ul>
      <h3 class="guide__sub">カード上部の色（加工カテゴリ）</h3>
      <ul class="swatches">
        {
          categories.map(([key, name]) => (
            <li data-category={key}>
              <span class="swatch" style="background: var(--category-color)" />
              <span>
                {name}
                <code>{key}</code>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <SectionHeader title="タイポグラフィ" />
      <div class="type-samples">
        <p class="type-hero">本が作りたくなる、フェアが見つかる。</p>
        <h1>見出し1：フェアを検索</h1>
        <h2>見出し2：新着フェア</h2>
        <h3>見出し3：秋の特殊紙フェア</h3>
        <p>本文：対象セットで、表紙用紙をラメ入りの特殊紙へ無料で変更できるフェア。行間は広めにとり、読みやすさを優先します。</p>
        <p class="muted">補足文字：さんぷる印刷（架空）</p>
        <p><a href="#">テキストリンク</a></p>
      </div>
    </section>

    <section>
      <SectionHeader title="状態ラベル（1枚のカードに1個だけ）" lead="優先順：本日終了 → 明日終了 → あと2〜3日 → UPDATE → NEW → あと4〜7日" />
      <div class="row">
        <StatusLabel kind="urgent" text="本日終了" />
        <StatusLabel kind="urgent" text="明日終了" />
        <StatusLabel kind="urgent" text="あと3日" />
        <StatusLabel kind="update" text="UPDATE" />
        <StatusLabel kind="new" text="NEW" />
        <StatusLabel kind="soon" text="あと6日" />
        <StatusLabel kind="ended" text="終了" />
      </div>
    </section>

    <section>
      <SectionHeader title="タグ／チップ" />
      <div class="row">
        <Chip label="箔押し" category="foil" />
        <Chip label="特殊紙" category="paper" />
        <Chip label="ホログラムPP" category="surface" />
        <Chip label="小口印刷" category="craft" />
        <Chip label="A6" />
        <Chip label="オンデマンド" />
        <Chip label="RGB対応" />
      </div>
    </section>

    <PopularProcesses id="popular-sample" />

    <section>
      <SectionHeader title="ボタン" />
      <div class="row">
        <Button>メイン</Button>
        <Button variant="secondary">サブ</Button>
        <Button variant="ghost">テキスト風</Button>
        <Button href="#" variant="primary">公式サイトで確認する →</Button>
      </div>
    </section>

    <section>
      <SectionHeader title="見方のタブ（トップ）" lead="タブは一覧ページへのリンク。JavaScript があればその場で切り替える" />
      <ViewTabs tabs={tabs} cards={sampleCards.slice(0, 3)} total={sampleCards.length} />
    </section>

    <section>
      <SectionHeader title="ページ送り（一覧ページ）" />
      <Pagination page={samplePage as any} />
    </section>

    <section>
      <SectionHeader title="フェアカード（サンプルデータ）" />
      <FairGrid cards={sampleCards} />
    </section>

    <section>
      <SectionHeader title="フェアカード（表示の限界）" lead="長いフェア名・長い特典文（2行で省略）・チップの省略・何もない場合" />
      <FairGrid cards={edgeCases} />
    </section>

    <section>
      <SectionHeader title="画像プレースホルダー" />
      <p class="muted">ヒーロー画像は四角い枠ではなく、トップページ右上に背景へ溶け込む形で表示します（2:1・推奨2400×1200px）。</p>
      <div class="images">
        <ImagePlaceholder alt="OGP画像" ratio="1200 / 630" label="OGP画像（1200×630px）" />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .guide {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-top: var(--space-5);
  }

  .guide__sub {
    margin: var(--space-5) 0 var(--space-3);
    font-size: var(--fs-base);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .swatches code {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--fs-xs);
  }

  .swatch {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .type-samples {
    display: grid;
    gap: var(--space-3);
  }

  .type-hero {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.3;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .images {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
