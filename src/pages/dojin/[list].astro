---
// 時期別・新着・更新・終了間近の一覧（仕様書10〜12章・36〜38章）
import ListPage from '../../components/ListPage.astro';
import { cardBuilder } from '../../lib/cards.ts';
import { archiveYears, listPages } from '../../lib/lists.ts';
import { SEARCH_HREF } from '../../lib/nav.ts';
import { PERIOD_FILTERS } from '../../lib/search.ts';
import { todayJST } from '../../lib/period.ts';

export function getStaticPaths() {
  return listPages(todayJST()).map((page) => ({ params: { list: page.slug } }));
}

const today = todayJST();
const page = listPages(today).find((p) => p.slug === Astro.params.list)!;
const { data, toCard } = cardBuilder(today);
const searchHref = page.slug in PERIOD_FILTERS ? `${SEARCH_HREF}?period=${page.slug}` : SEARCH_HREF;
---

<ListPage
  title={page.title}
  description={page.description}
  cards={page.select(data.fairs).map(toCard)}
  searchHref={searchHref}
  archiveYears={archiveYears(data.fairs, today)}
/>
