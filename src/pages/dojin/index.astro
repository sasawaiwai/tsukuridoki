---
// フェアを探す：探し方の入口（phase2-design.md 9章）
import BaseLayout from '../../layouts/BaseLayout.astro';
import PopularProcesses from '../../components/PopularProcesses.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Chip from '../../components/Chip.astro';
import Button from '../../components/Button.astro';
import { loadSiteData } from '../../lib/data.ts';
import { ATTRIBUTE_AXES, archiveYears, attributeValues } from '../../lib/lists.ts';
import { LIST_PAGES, PRINTERS_HREF, SEARCH_HREF } from '../../lib/nav.ts';
import { todayJST } from '../../lib/period.ts';
import { processCategory, processMap } from '../../lib/fair-display.ts';

const today = todayJST();
const data = loadSiteData();
const processes = processMap(data.processes);
const values = attributeValues(data);
const usedPrinters = new Set(data.fairs.map((f) => f.printer_id));
const printers = data.printers.filter((p) => p.crawl_policy !== 'forbidden' && usedPrinters.has(p.printer_id));
const years = archiveYears(data.fairs, today);
const viewLinks = Object.values(LIST_PAGES);
---

<BaseLayout title="フェアを探す" description="同人誌印刷所のフェアを、入稿時期・加工・サイズ・印刷方式・色・特典・印刷所から探せます。">
  <div class="container find">
    <header class="find__header">
      <h1>フェアを探す</h1>
      <p class="find__lead">いつ入稿するか、どんな本を作りたいかから、使えるフェアを探せます。</p>
      <p><Button href={SEARCH_HREF}>条件を組み合わせて探す</Button></p>
    </header>

    <section class="find__section">
      <SectionHeader title="時期から探す" />
      <ul class="find__chips">
        {viewLinks.map((link) => <li><Chip label={link.label} href={link.href} size="md" /></li>)}
      </ul>
    </section>

    <PopularProcesses id="popular-processes" />

    {
      ATTRIBUTE_AXES.map((def) => {
        const items = values.filter((v) => v.axis === def.axis);
        return (
          items.length > 0 && (
            <section class="find__section">
              <SectionHeader title={`${def.label}から探す`} />
              <ul class="find__chips">
                {items.map((v) => (
                  <li>
                    <Chip
                      label={v.label}
                      href={v.href}
                      size="md"
                      category={v.axis === 'process' ? processCategory(v.value, processes) : undefined}
                    />
                  </li>
                ))}
              </ul>
            </section>
          )
        );
      })
    }

    <section class="find__section">
      <SectionHeader title="印刷所から探す" moreHref={PRINTERS_HREF} moreLabel="印刷所一覧" />
      <ul class="find__chips">
        {printers.map((p) => <li><Chip label={p.name} href={`/dojin/printer/${p.printer_id}/`} size="md" /></li>)}
      </ul>
    </section>

    {
      years.length > 0 && (
        <section class="find__section">
          <SectionHeader title="終了したフェア" lead="過去に開催されたフェアの記録です。" />
          <ul class="find__chips">
            {years.map((year) => <li><Chip label={`${year}年`} href={`/dojin/archive/${year}/`} size="md" /></li>)}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .find {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-top: var(--space-5);
  }

  .find__header {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .find__lead {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }

  .find__section {
    display: grid;
    gap: var(--space-3);
  }

  .find__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
