---
import '../styles/global.css';
import { SITE } from '../lib/site.ts';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { todayJST } from '../lib/period.ts';
import { formatJpDate } from '../lib/fair-display.ts';

interface Props {
  title?: string;
  description?: string;
  /** サイト全体の設定にかかわらず検索エンジンに載せない（/dev/ 以下など） */
  noindex?: boolean;
  /** 開催状況など、日付で変わる表示があるページ。日付が変わったのに再公開がまだのとき、時点の注意を出す */
  dated?: boolean;
}

const {
  title,
  description = `${SITE.tagline}。各印刷所のフェア・キャンペーン情報を、時期・加工・サイズから探せます。`,
  noindex = false,
  dated = false,
} = Astro.props;
// 毎日の再公開は数時間遅れることがあるため、ページを作った日（日本時間）を埋め込み、見ている日と違えば注意を出す（60章）
const builtOn = todayJST();
const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// アクセス解析は本番ビルドだけ。確認用ページ（noindex 指定）では読み込まない
const gaId = import.meta.env.PROD && !noindex ? SITE.gaMeasurementId : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(SITE.noindex || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbf7f1" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {SITE.ogImage && <meta property="og:image" content={new URL(SITE.ogImage, Astro.site).href} />}
    <meta name="twitter:card" content={SITE.ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <SiteHeader />
    {
      dated && (
        <>
          <p class="date-notice" id="date-notice" data-built-on={builtOn} role="status" hidden>
            この表示は{formatJpDate(builtOn)}時点の内容です。日付が変わった直後は、開催状況や締切までの日数が新しくなるまで数時間かかることがあります。
          </p>
          <script is:inline>
            (() => {
              const el = document.getElementById('date-notice');
              const now = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
              if (el && now > el.dataset.builtOn) el.hidden = false;
            })();
          </script>
        </>
      )
    }
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
